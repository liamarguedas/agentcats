{
  "name": "@agentcats/ui",
  "version": "0.0.0",
  "private": true,
  "description": "agentcats whiteboard UI. Built into dist/ and served by the daemon.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:daemon": "node --conditions=@agentcats/source --import tsx scripts/mock-daemon.ts",
    "dev:all": "node scripts/dev.mjs",
    "build": "vite build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@agentcats/protocol": "workspace:*",
    "react": "19.1.10",
    "react-dom": "19.1.10",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@agentcats/adapter-mock": "workspace:*",
    "@agentcats/daemon": "workspace:*",
    "@playwright/test": "1.64.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/ws": "8.18.2",
    "@vitejs/plugin-react": "6.1.2",
    "ws": "8.22.0"
  }
}
