{
  "name": "@agentcats/adapter-claude",
  "version": "0.0.0",
  "private": true,
  "description": "Claude adapter for agentcats, built on the Claude Agent SDK. Runs your installed claude CLI.",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "@agentcats/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@agentcats/kit": "workspace:*",
    "@agentcats/protocol": "workspace:*",
    "@anthropic-ai/claude-agent-sdk": "0.3.311"
  }
}
