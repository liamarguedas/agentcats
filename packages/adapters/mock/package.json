      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@agentcats/kit": "workspace:*",
    "@agentcats/protocol": "workspace:*",
    "@modelcontextprotocol/sdk": "1.32.2"
  }
}
