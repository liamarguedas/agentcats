{
  "name": "@agentcats/adapter-acp",
  "version": "0.0.0",
  "description": "Generic Agent Client Protocol adapter for agentcats: drives any ACP agent over stdio.",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "@agentcats/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "2.1.0",
    "@agentcats/kit": "workspace:*",
    "@agentcats/protocol": "workspace:*"
  }
}
