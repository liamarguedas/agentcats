{
  "name": "@agentcats/adapter-codex",
  "version": "0.0.0",
  "private": true,
  "description": "Codex adapter for agentcats, over the Agent Client Protocol through codex-acp. Uses your Codex login and config.",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "@agentcats/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@agentcats/adapter-acp": "workspace:*",
    "@agentcats/protocol": "workspace:*",
    "@zed-industries/codex-acp": "0.16.0"
  }
}
