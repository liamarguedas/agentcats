{
  "name": "agentcats",
  "version": "0.2.1",
  "description": "A local whiteboard where coding agents are cats.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "bin": {
    "agentcats": "bin/agentcats.mjs"
  },
  "files": [
    "bin",
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "pack:build": "node scripts/pack.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@agentcats/adapter-claude": "workspace:*",
    "@agentcats/adapter-codex": "workspace:*",
    "@agentcats/adapter-mock": "workspace:*",
    "@agentcats/daemon": "workspace:*",
    "@agentcats/protocol": "workspace:*",
    "@agentcats/ui": "workspace:*"
  },
  "devDependencies": {
    "@agentcats/kit": "workspace:*",
    "esbuild": "0.28.2"
  }
}
